{
  "prompts": {},
  "resource_templates": [],
  "tools": {
    "create_proposal_draft": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Create a proposal DRAFT (nothing is sent, no Connects spent). With dry_run=true returns exactly what would be created and its Connects cost.",
      "input": {
        "properties": {
          "bid_amount": {
            "exclusiveMinimum": 0,
            "maximum": 100000,
            "title": "Bid Amount",
            "type": "number"
          },
          "cover_letter": {
            "maxLength": 3000,
            "minLength": 150,
            "title": "Cover Letter",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotency_key": {
            "description": "Unique per logical action; a retry with the same key never repeats the effect",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "maxLength": 64,
            "minLength": 3,
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "cover_letter",
          "bid_amount",
          "idempotency_key"
        ],
        "title": "create_proposal_draftArguments",
        "type": "object"
      },
      "output": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "dry_run": {
            "default": false,
            "title": "Dry Run",
            "type": "boolean"
          },
          "replayed": {
            "default": false,
            "description": "true if this idempotency key was already applied",
            "title": "Replayed",
            "type": "boolean"
          }
        },
        "required": [
          "data"
        ],
        "title": "WriteResult",
        "type": "object"
      }
    },
