---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	intake(intake)
	analyst(analyst)
	risk(risk)
	fit(fit)
	decide(decide)
	pricing(pricing)
	writer(writer)
	verify(verify)
	critic(critic)
	compliance(compliance)
	approval(approval)
	submit(submit)
	__end__([<p>__end__</p>]):::last
	__start__ --> intake;
	analyst --> decide;
	approval -.-> __end__;
	approval -.-> submit;
	compliance -.-> __end__;
	compliance -.-> approval;
	critic -.-> compliance;
	critic -.-> writer;
	decide -.-> __end__;
	decide -.-> pricing;
	fit --> decide;
	intake -.-> analyst;
	intake -.-> fit;
	intake -.-> risk;
	pricing -.-> __end__;
	pricing -.-> writer;
	risk --> decide;
	verify --> critic;
	writer --> verify;
	submit --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
